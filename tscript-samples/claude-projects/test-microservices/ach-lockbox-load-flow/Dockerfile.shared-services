# Shared build and runtime base for active services in docker-compose

FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY services/*/package.json services/*/
COPY shared/*/package.json shared/*/
RUN npm ci

FROM deps AS builder
COPY tsconfig.json ./
COPY shared ./shared
COPY services ./services
RUN npm run build

FROM node:20-alpine AS shared-components
WORKDIR /app
ENV NODE_ENV=development

COPY package.json package-lock.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/shared ./shared

CMD ["sh", "-c", "echo 'shared components image ready' && tail -f /dev/null"]

FROM shared-components AS api-gateway-runtime
COPY --from=builder /app/services/api-gateway ./services/api-gateway
EXPOSE 3000
CMD ["node", "services/api-gateway/dist/index.js"]

