# Global environment configuration

# Node environment
NODE_ENV=development
LOG_LEVEL=debug

# Kafka configuration
KAFKA_BROKER=kafka:29092
KAFKA_CLIENT_ID=ach-lockbox-client

# Database configuration (all services share single Postgres)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/appdb

# JWT configuration
JWT_PUBLIC_KEY=
JWT_ISSUER=ach-lockbox-platform
JWT_AUDIENCE=api

# Service discovery
SERVICE_NAME=api-gateway
API_GATEWAY_URL=http://api-gateway:3000

# Observability
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
OTEL_ENABLED=false

# Redis (for caching and idempotency)
REDIS_URL=redis://redis:6379

# Reconciliation settings
ML_CONFIDENCE_THRESHOLD=0.85

# Event sourcing
EVENT_RETENTION_DAYS=2555
SNAPSHOT_INTERVAL=100
